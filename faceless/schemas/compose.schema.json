{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "compose",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "audio_duration_s": {
      "type": "number",
      "minimum": 0
    },
    "renders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "engine": {
            "enum": [
              "remotion",
              "ffmpeg"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "duration_s": {
            "type": "number",
            "minimum": 0
          },
          "fps": {
            "type": "number"
          },
          "has_audio": {
            "type": "boolean"
          }
        },
        "required": [
          "platform",
          "engine",
          "path",
          "width",
          "height",
          "duration_s",
          "has_audio"
        ],
        "additionalProperties": true
      }
    },
    "preview_reviewed": {
      "type": "boolean"
    },
    "review_notes": {
      "type": "string"
    }
  },
  "required": [
    "renders",
    "preview_reviewed"
  ],
  "additionalProperties": true
}
