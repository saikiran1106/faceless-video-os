{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "package",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "vidiq_used": {
      "type": "boolean"
    },
    "primary_keyword": {
      "type": "string"
    },
    "keyword_research": {
      "type": "array"
    },
    "title_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": true
      }
    },
    "youtube": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "time",
              "title"
            ],
            "additionalProperties": true
          }
        },
        "thumbnail_path": {
          "type": "string"
        },
        "thumbnail_text": {
          "type": "string"
        },
        "made_for_kids": {
          "type": "boolean"
        },
        "pinned_comment": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "tags",
        "hashtags"
      ],
      "additionalProperties": true
    },
    "shorts": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": true
    },
    "instagram": {
      "type": "object",
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "caption"
      ],
      "additionalProperties": true
    },
    "captions_srt": {
      "type": "string"
    }
  },
  "required": [
    "vidiq_used",
    "youtube"
  ],
  "additionalProperties": true
}
