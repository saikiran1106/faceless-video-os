{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "transcript",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "audio_path": {
      "type": "string",
      "minLength": 1
    },
    "audio_sha256": {
      "type": "string",
      "minLength": 1
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "text",
          "start",
          "end"
        ],
        "additionalProperties": true
      }
    },
    "script_match": {
      "type": "object",
      "properties": {
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extra": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ratio"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "provider",
    "audio_path",
    "audio_sha256",
    "duration_s",
    "text",
    "words"
  ],
  "additionalProperties": true
}
