{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "script",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "written",
        "transcript"
      ]
    },
    "narration": {
      "type": "string",
      "minLength": 1
    },
    "hook": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": true
    },
    "promise": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "payoff": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "question",
        "payoff"
      ],
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "section_id",
          "title",
          "text"
        ],
        "additionalProperties": true
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": true
      }
    },
    "cta": {
      "type": "object",
      "properties": {
        "mid": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "pronunciation": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "language",
    "title",
    "source",
    "narration",
    "hook",
    "promise",
    "sections"
  ],
  "additionalProperties": true
}
