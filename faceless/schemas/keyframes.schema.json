{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "keyframes",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "keyframe_id": {
            "type": "string",
            "minLength": 1
          },
          "beat_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "prompt_sha256": {
            "type": "string"
          },
          "qa_status": {
            "enum": [
              "pending",
              "pass",
              "fail"
            ]
          },
          "qa_note": {
            "type": "string"
          }
        },
        "required": [
          "keyframe_id",
          "beat_id",
          "path",
          "sha256",
          "source",
          "qa_status"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "keyframes"
  ],
  "additionalProperties": true
}
