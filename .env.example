# Copy to .env (faceless setup does it) and fill in only what you have.
# Nothing is required: with no keys you can still upload your own voice,
# transcribe locally, generate images manually/in Codex, and render.

# --- Voice + transcription (best quality, 90+ languages) ---
ELEVENLABS_API_KEY=

# --- OpenAI: TTS voice, Whisper transcription, Images API ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Optional model overrides ---
# FACELESS_SCRIBE_MODEL=scribe_v2
# FACELESS_OPENAI_ASR_MODEL=whisper-1
# FACELESS_OPENAI_IMAGE_MODEL=gpt-image-1
# FACELESS_OPENAI_IMAGE_QUALITY=medium        # low | medium | high
# FACELESS_LOCAL_WHISPER_MODEL=small          # tiny | base | small | medium | large-v3

# --- Cost estimates (USD) used for budget checks; set to your plan's real rates ---
# FACELESS_ELEVENLABS_USD_PER_1K_CHARS=0.30
# FACELESS_OPENAI_TTS_USD_PER_1K_CHARS=0.015
# FACELESS_SCRIBE_USD_PER_MIN=0.0067
# FACELESS_WHISPER_USD_PER_MIN=0.006
# FACELESS_OPENAI_IMAGE_USD=0.07

# --- Claude Code image host (ChatGPT via Playwright) ---
# FACELESS_CHATGPT_PROJECT_URL=https://chatgpt.com/g/g-p-XXXX/project
# FACELESS_BROWSER_PROFILE=~/.faceless/browser-profiles/chatgpt-imagegen
# FACELESS_BROWSER_HEADLESS=0
# FACELESS_BROWSER_GEN_TIMEOUT=180
